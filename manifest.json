{
  "manifest_version": 3,
  "name": "Tab Vault",
  "version": "1.0.0",
  "description": "Fully close tabs to reclaim RAM/CPU while preserving them in an organized vault.",
  "permissions": [
    "tabs",
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/assets/icon16.png",
      "48": "src/assets/icon48.png"
    }
  },
  "icons": {
    "16": "src/assets/icon16.png",
    "48": "src/assets/icon48.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "commands": {
    "shutdown-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Vault the current tab"
    },
    "shutdown-all-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Vault all tabs (except home tabs)"
    }
  }
}
