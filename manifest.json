{
  "manifest_version": 3,
  "name": "Tab Goblin",
  "version": "2.0.0",
  "description": "Fully close tabs to reclaim RAM/CPU while preserving them in an organized vault. Tab Goblin helps you manage browser tab overload.",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "action": {
    "default_icon": {
      "16": "src/assets/logo_round_16.png",
      "48": "src/assets/logo_round_48.png",
      "128": "src/assets/logo_round_128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "src/assets/logo_round_16.png",
    "48": "src/assets/logo_round_48.png",
    "128": "src/assets/logo_round_128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Open Tab Goblin"
    },
    "shutdown-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Vault the current tab"
    },
    "shutdown-all-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Vault all tabs (except home tabs)"
    }
  }
}
